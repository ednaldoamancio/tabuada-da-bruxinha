<!-- Link para o Manifesto do PWA -->
<link rel="manifest" href="/manifest.json">

<!-- Ícones para Navegador (Favicon) e iOS -->
<link rel="icon" type="image/png" href="icone-192.png">
<link rel="apple-touch-icon" href="icone-192.png">

<!-- Configuração de cor da barra para iOS -->
<meta name="apple-mobile-web-app-status-bar-style" content="#2d1254">

<!-- Script para registrar o Service Worker -->
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js')
        .then(reg => console.log('Service Worker registrado com sucesso!', reg.scope))
        .catch(err => console.log('Erro ao registrar o Service Worker:', err));
    });
  }
</script>
</head>